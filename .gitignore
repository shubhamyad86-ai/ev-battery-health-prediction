# ==========================================
# Data (raw/processed datasets stay OUT of
# git — usually large and/or not yours to
# redistribute. Re-generate with the pipeline.)
# ==========================================
data/raw/*
!data/raw/.gitkeep

data/processed/*
!data/processed/.gitkeep

# Local database
users.db
*.db

# ==========================================

# Required trained models
models/best_model.pkl
models/linear_regression.pkl
models/scaler.pkl

# Other model artifacts - ignored
models/decision_tree.pkl
models/gradient_boosting.pkl
models/lasso_regression.pkl
models/random_forest.pkl
models/random_forest_tuned.pkl
models/ridge_regression.pkl
models/xgboost.pkl

reports/*
!reports/.gitkeep

images/*
!images/.gitkeep
!images/dashboard.png

# App-generated run outputs (personal prediction
# history / reports — not something to publish)
predictions.csv
battery_health_report.pdf
*.log

